# Database
DATABASE_URL="postgresql://username:password@localhost:5432/rve_platform?schema=public"

# Redis (optional - for caching)
REDIS_URL="redis://localhost:6379"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# M-Pesa / Safaricom Daraja (optional — omit for demo STK + B2C flows in UI)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Must be a public HTTPS URL Safaricom can POST to (implement callback handler + idempotent treasury credit)
MPESA_STK_CALLBACK_URL=

# B2C disbursement (earnings, microgrants, off-ramp) — optional; requires encrypted SecurityCredential from Daraja
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=
MPESA_B2C_QUEUE_TIMEOUT_URL=
