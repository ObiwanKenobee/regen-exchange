// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  did               String?  @unique
  role              String   @default("student_researcher") // RBAC role type
  ridScore          Float    @default(0)
  reputationHistory Json?
  mpesaNumber       String?
  walletAddress     String?
  email             String?  @unique
  // Extended fields for steward profile
  name              String?
  location          String?
  skills            Json?    // Array of skill strings
  certifications    Json?    // Array of certification strings
  bio               String?
  avatar            String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  orders            Order[]
  portfolio         Portfolio?
  riuStakes         RIUStake[]
  governanceVotes   GovernanceVote[]
  sensorReadings    SensorReading[]
  geospatialFeatures GeospatialFeature[]
  ownedAssets       AssetOwnership[]
  createdMissions   Mission[]
  missionParticipations MissionParticipant[]
  listings          Listing[]

  @@map("users")
}

model Asset {
  id                String   @id @default(cuid())
  symbol            String   @unique
  name              String
  type              String   // carbon, water, biodiversity, cultural, urban
  category          String?  // environmental, social, economic
  description       String?
  totalSupply       Float?
  currentPrice      Float
  marketCap         Float?
  verificationScore Float    @default(0)
  oracleId          String?
  contractAddress   String?
  unit              String?  // tCO2, hectares, m³, etc.
  isActive          Boolean  @default(true)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  orders            Order[]
  portfolioItems    PortfolioItem[]
  ownerships        AssetOwnership[]
  listings          Listing[]

  @@map("assets")
}

model Order {
  id                String   @id @default(cuid())
  userId            String
  assetId           String
  side              String   // buy, sell
  orderType         String   @default("market") // market, limit
  quantity          Float
  price             Float?
  status            String   @default("pending") // pending, filled, cancelled, rejected
  txHash            String?
  oracleVerificationId String?
  executedAt        DateTime?
  createdAt         DateTime @default(now())

  // Relations
  user              User     @relation(fields: [userId], references: [id])
  asset             Asset    @relation(fields: [assetId], references: [id])

  @@map("orders")
}

model Listing {
  id                String   @id @default(cuid())
  assetId           String
  sellerId          String
  type              String   // sell, buy, auction, swap
  status            String   @default("active") // active, pending, completed, cancelled
  quantity          Float
  unit              String
  price             Float    // RIUS price
  usdPrice          Float?
  conditions        Json?    // minQuality, certifications, location, deliveryTerms
  auctionData       Json?    // startPrice, reservePrice, endTime, bids
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  asset             Asset    @relation(fields: [assetId], references: [id])
  seller            User     @relation(fields: [sellerId], references: [id])
  orders            Order[]

  @@map("listings")
}

model Portfolio {
  id        String @id @default(cuid())
  userId    String @unique
  totalValue Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User @relation(fields: [userId], references: [id])
  items   PortfolioItem[]

  @@map("portfolios")
}

model PortfolioItem {
  id       String @id @default(cuid())
  portfolioId String
  assetId  String
  quantity Float
  avgPrice Float
  currentValue Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  portfolio Portfolio @relation(fields: [portfolioId], references: [id])
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@map("portfolio_items")
}

model RIUMint {
  id                String   @id @default(cuid())
  userId            String
  oracleVerificationId String
  amount            Float
  txHash            String?
  contractAddress   String?
  mintedAt          DateTime @default(now())

  // Relations
  user              User     @relation(fields: [userId], references: [id])

  @@map("riu_mints")
}

model RIUStake {
  id                String   @id @default(cuid())
  userId            String
  amount            Float
  lockPeriodDays    Int
  apy               Float
  rewardsClaimed    Float    @default(0)
  stakedAt          DateTime @default(now())
  unstakedAt        DateTime?

  // Relations
  user              User     @relation(fields: [userId], references: [id])

  @@map("riu_stakes")
}

model GovernanceProposal {
  id                String   @id @default(cuid())
  title             String
  description       String
  proposerId        String
  contractAddress   String?
  executionData     Json?
  status            String   @default("active") // active, passed, rejected, executed
  votingStartsAt    DateTime?
  votingEndsAt      DateTime?
  createdAt         DateTime @default(now())

  // Relations
  proposer          User     @relation(fields: [proposerId], references: [id])
  votes             GovernanceVote[]

  @@map("governance_proposals")
}

model GovernanceVote {
  id            String @id @default(cuid())
  proposalId    String
  userId        String
  vote          String // for, against, abstain
  votingPower   Float
  votedAt       DateTime @default(now())

  // Relations
  proposal      GovernanceProposal @relation(fields: [proposalId], references: [id])
  user          User               @relation(fields: [userId], references: [id])

  @@unique([proposalId, userId])
  @@map("governance_votes")
}

model Sensor {
  id            String   @id @default(cuid())
  type          String   // air_quality, soil_moisture, water_level, weather
  location      Json?    // GeoJSON Point
  ownerId       String?
  status        String   @default("active") // active, inactive, maintenance
  batteryLevel  Float?
  firmwareVersion String?
  lastSeen      DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())

  // Relations
  owner         User?            @relation(fields: [ownerId], references: [id])
  readings      SensorReading[]

  @@map("sensors")
}

model SensorReading {
  id        String   @id @default(cuid())
  sensorId  String
  timestamp DateTime
  metric    String   // temperature, humidity, ph, turbidity
  value     Float
  unit      String
  qualityScore Float?
  rawData   Json?
  createdAt DateTime @default(now())

  // Relations
  sensor    Sensor   @relation(fields: [sensorId], references: [id])

  @@map("sensor_readings")
}

model GeospatialFeature {
  id            String   @id @default(cuid())
  type          String   // restoration_zone, sensor_location, biodiversity_hotspot
  geometry      Json?    // GeoJSON geometry
  properties    Json?
  source        String?  // oracle, community, satellite
  verificationScore Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  owner         User?    @relation(fields: [ownerId], references: [id])

  ownerId       String?
  @@map("geospatial_features")
}

model OracleVerification {
  id                String   @id @default(cuid())
  type              String   // satellite, iot, drone, community
  assetId           String?
  status            String   @default("processing") // processing, verified, rejected
  confidence        Float    @default(0)
  inputs            Json?    // Array of input sources
  results           Json?    // Verification results
  processedAt       DateTime?
  createdAt         DateTime @default(now())

  @@map("oracle_verifications")
}

model MPesaTransaction {
  id                String   @id @default(cuid())
  userId            String?
  transactionId     String   @unique
  amount            Float
  phoneNumber       String
  accountReference  String
  transactionDesc   String
  transactionType   String   // C2B, B2C, STK
  status            String   @default("pending") // pending, completed, failed
  resultCode        String?
  resultDesc        String?
  processedAt       DateTime?
  createdAt         DateTime @default(now())

  // Relations
  user              User?    @relation(fields: [userId], references: [id])

  @@map("mpesa_transactions")
}

// New models for extended functionality
model AssetOwnership {
  id            String   @id @default(cuid())
  assetId       String
  userId        String
  percentage    Float    // Percentage of ownership (0-100)
  quantity      Float    // Actual quantity owned
  acquiredAt    DateTime @default(now())
  acquiredPrice Float?   // Price per unit when acquired
  source        String?  // How ownership was acquired (mint, purchase, etc.)

  // Relations
  asset         Asset    @relation(fields: [assetId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([assetId, userId])
  @@map("asset_ownerships")
}

model Mission {
  id                String   @id @default(cuid())
  title             String
  description       String
  type              String   // restoration, monitoring, education, etc.
  status            String   @default("active") // active, completed, cancelled
  location          Json?    // GeoJSON location
  targetCompletion  DateTime?
  rewardAmount      Float    @default(0)
  rewardToken       String   @default("RIUS")
  requiredSkills    Json?    // Array of required skills
  maxParticipants   Int?
  currentParticipants Int     @default(0)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  createdBy         User     @relation(fields: [createdById], references: [id])
  participants      MissionParticipant[]

  @@map("missions")
}

model MissionParticipant {
  id            String   @id @default(cuid())
  missionId     String
  userId        String
  joinedAt      DateTime @default(now())
  completedAt   DateTime?
  status        String   @default("active") // active, completed, withdrawn
  contribution  Float    @default(0) // Contribution score/percentage

  // Relations
  mission       Mission  @relation(fields: [missionId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([missionId, userId])
  @@map("mission_participants")
}

model Oracle {
  id            String   @id @default(cuid())
  name          String
  type          String   // ai, human, iot, satellite
  specialty     String?  // carbon, water, biodiversity, etc.
  accuracy      Float    @default(0)
  totalVerifications Int  @default(0)
  successfulVerifications Int @default(0)
  isActive      Boolean  @default(true)
  credentials   Json?    // API keys, certifications, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  verifications OracleVerification[]

  @@map("oracles")
}

model GovernanceProposal {
  id                String   @id @default(cuid())
  title             String
  description       String
  proposerId        String
  contractAddress   String?
  executionData     Json?
  status            String   @default("active") // active, passed, rejected, executed
  votingStartsAt    DateTime?
  votingEndsAt      DateTime?
  quorumRequired    Float    @default(0.1) // Percentage required for quorum
  createdAt         DateTime @default(now())

  // Relations
  proposer          User     @relation(fields: [proposerId], references: [id])
  votes             GovernanceVote[]

  @@map("governance_proposals")
}

model GovernanceVote {
  id            String @id @default(cuid())
  proposalId    String
  userId        String
  vote          String // for, against, abstain
  votingPower   Float
  votedAt       DateTime @default(now())

  // Relations
  proposal      GovernanceProposal @relation(fields: [proposalId], references: [id])
  user          User               @relation(fields: [userId], references: [id])

  @@unique([proposalId, userId])
  @@map("governance_votes")
}